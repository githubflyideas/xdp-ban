# 构建产物
/xdp-ban
/xdp-agent
/xdp-sampler
/dist/
*.exe
*.db
*.db-journal
*.db-wal
coverage.out
coverage.html

# 编译出的 eBPF 目标(由 `make bpf` 生成;仓库保留占位空文件供无 clang 环境编译)
cmd/xdp-agent/obj/*.o
cmd/xdp-sampler/obj/*.o
!cmd/xdp-agent/obj/.gitkeep
!cmd/xdp-sampler/obj/.gitkeep

# 依赖
/vendor/

# 设计/内部文档(不进公开仓库,不暴露设计思路与关键解析)
/design/
/internal-docs/
PROGRESS*.md
*_DESIGN.md
API_CONTRACT*.md
TRANSPORT*.md
TESTING.md

# 编辑器
.DS_Store
.idea/
.vscode/
*.test
